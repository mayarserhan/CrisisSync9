@startuml
left to right direction
skinparam packageStyle rectangle
skinparam linetype ortho

actor "System Administrator" as Admin
actor "Logistics Officer" as Logistics
actor Dispatcher
actor "Field Commander" as Commander
actor "Field Crew Member" as Crew

rectangle "CrisisSync" as CrisisSync {
  package "Access and Administration" {
    usecase "UC01\nLog In" as UC01
    usecase "UC02\nAdminister User Accounts\nand Permissions" as UC02
    usecase "UC03\nLoad Initial Data" as UC03
    usecase "UC04\nInspect Incident History" as UC04
    usecase "UC05\nView and Generate\nAdministrative Reports" as UC05
  }

  package "Resource Management" {
    usecase "UC06\nUpdate Equipment\nMaintenance Status" as UC06
    usecase "UC07\nTransfer Equipment\nBetween Stations" as UC07
    usecase "UC08\nRecord Exceptional\nCrew Unavailability" as UC08
    usecase "UC20\nStart Shift and\nReport Readiness" as UC20
    usecase "UC21\nView Assigned Task" as UC21
    usecase "UC19\nReport Equipment Failure" as UC19
    usecase "UC17\nAssign Replacement Equipment" as UC17
  }

  package "Incident and Task Coordination" {
    usecase "UC09\nCreate Incident" as UC09
    usecase "UC10\nDefine Tasks and Dependencies" as UC10
    usecase "UC11\nReserve Resource Bundle Manually" as UC11
    usecase "UC12\nAllocate Resource Bundle Automatically" as UC12
    usecase "UC13\nView Live Incident Status" as UC13
    usecase "UC14\nCancel Task" as UC14
    usecase "UC15\nCancel Incident" as UC15
    usecase "UC18\nReport Task Completion" as UC18
    usecase "UC24\nInvalid Task Dependency" as UC24
    usecase "UC25\nResource Reservation Conflict" as UC25
    usecase "UC26\nAutomatic Allocation Retry" as UC26
    usecase "UC27\nCascade Task Cancellation" as UC27
  }

  package "Settlement and Reporting" {
    usecase "UC16\nClose Incident and Settle Costs" as UC16
    usecase "UC22\nCalculate Operating Costs" as UC22
    usecase "UC23\nRequest Settlement Approval" as UC23
    usecase "UC28\nSettlement Rejection" as UC28
    usecase "UC29\nAutomatically Generate\nMonthly Reports" as UC29
  }
}

actor "National Clearing and\nSettlement System" as Settlement
actor "System Clock /\nScheduler" as Scheduler

Settlement -[hidden]right- Scheduler

Admin -right- UC01
Logistics -right- UC01
Dispatcher -right- UC01
Commander -right- UC01
Crew -right- UC01

Admin -right- UC02
Admin -right- UC03
Admin -right- UC04
Admin -right- UC05

Logistics -right- UC06
Logistics -right- UC07
Logistics -right- UC08

Dispatcher -right- UC09
Dispatcher -right- UC10
Dispatcher -right- UC11
Dispatcher -right- UC12
Dispatcher -right- UC13
Dispatcher -right- UC14
Dispatcher -right- UC15
Dispatcher -right- UC16
Dispatcher -right- UC17

Commander -right- UC13
Commander -right- UC18
Commander -right- UC19

Crew -right- UC19
Crew -right- UC20
Crew -right- UC21

Scheduler -left- UC29
UC23 -right- Settlement

UC16 ..> UC22 : <<include>>
UC16 ..> UC23 : <<include>>
UC19 ..> UC17 : <<include>>

UC24 ..> UC10 : <<extend>>
UC25 ..> UC11 : <<extend>>
UC26 ..> UC12 : <<extend>>
UC27 ..> UC14 : <<extend>>
UC28 ..> UC16 : <<extend>>

note right of UC12
  Automatically tries up to two
  next-best alternatives. Allocation
  fails if no viable alternative exists.
end note

@enduml
